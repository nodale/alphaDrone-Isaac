<?xml version="1.0"?>
<robot name="IntelRealsenseD435i">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="IntelRealsenseD435.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="IntelRealsenseD435.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0"/>
      <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
    </inertial>
  </link>

</robot>

