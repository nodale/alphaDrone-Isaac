<?xml version="1.0"?>
<robot name="quadrotor">

  <!-- main body -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_boy.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_boy.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.650"/>
      <inertia ixx="0.093" iyy="0.078" izz="0.132" ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0.0096 -0.00008 -0.07219" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- rotor links -->
  <link name="rotor_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <link name="rotor_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <link name="rotor_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <link name="rotor_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="stl/simplified_motor.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </inertial>
  </link>

  <!-- rotors to base -->
  <joint name="rotor_1_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <origin xyz="0.197 -0.22465 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1000" effort="1.0" velocity="1000"/>
  </joint>

  <joint name="rotor_2_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <origin xyz="0.197 0.22465 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1000" effort="1.0" velocity="1000"/>
  </joint>

  <joint name="rotor_3_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <origin xyz="-0.217 0.22465 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1000" effort="1.0" velocity="1000"/>
  </joint>

  <joint name="rotor_4_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rotor_4"/>
    <origin xyz="-0.217 -0.22465 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1000" effort="1.0" velocity="1000"/>
  </joint>

</robot>

